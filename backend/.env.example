# Server Environment
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/sapphireiq

# Authentication
JWT_SECRET=replace_with_a_secure_random_string_at_least_16_characters
JWT_EXPIRES_IN=7d

# SMTP / Email Service (Optional: for password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@sapphireiq.local

# ImageKit CDN (Optional: falls back to local disk storage if unset)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
