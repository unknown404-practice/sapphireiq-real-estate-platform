# SapphireIQ Monorepo Environment Configuration
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/sapphireiq
JWT_SECRET=replace_with_a_secure_random_string_at_least_16_characters
APP_ORIGIN=http://localhost:5173

# Email / SMTP (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@sapphireiq.local

# ImageKit (Optional)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
